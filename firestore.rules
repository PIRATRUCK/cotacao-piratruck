rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN vê tudo (por e-mail de login). Adicione outros e-mails na lista se precisar.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['piratruck.inteligente@outlook.com'];
    }

    // COTAÇÕES: cada vendedor só as próprias; admin vê/edita todas.
    match /cotacoes/{id} {
      allow read:   if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    // CHECKLIST de veículos: mantém como estava (qualquer usuário logado).
    match /checklist_veiculos/{id} {
      allow read, write: if request.auth != null;
    }

    // Qualquer outra coleção: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
